# Copy to .env and fill in. Never commit .env.
# Defaults below match docker-compose; none of these values are real secrets.
REACHSET_DATABASE_URL=postgresql+asyncpg://reachset:reachset@localhost:5442/reachset
REACHSET_REDIS_URL=redis://localhost:6390/0
REACHSET_VAULT_ADDR=http://localhost:8220
# Dev-server root token for local compose only. A real deployment uses an auth method.
REACHSET_VAULT_TOKEN=changeme
REACHSET_LOG_LEVEL=INFO
